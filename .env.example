# University System (Week 10 Capstone) — Database Configuration
# Copy this file to .env or .env.local and fill in your Neon PostgreSQL connection string.
# Do NOT commit .env or .env.local (both are in .gitignore).

# Option 1: Single connection URL from your Neon dashboard (recommended)
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST.neon.tech/neondb?sslmode=require"

# Option 2: Individual PostgreSQL parameters (used if DATABASE_URL is not set)
# PGHOST="YOUR-NEON-HOST.neon.tech"
# PGPORT="5432"
# PGDATABASE="neondb"
# PGUSER="USER"
# PGPASSWORD="PASSWORD"
# PGSSLMODE="require"
